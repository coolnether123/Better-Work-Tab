  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Runs unconditionally so that an unverifiable mirror is reported rather than
    skipped. Gating the whole target on StandaloneSpineRoot made verification
      depend on the building machine's checkout layout, and a build that could not
      verify looked exactly like one that did. The shared build control plane
      supplies the resolved root; direct MSBuild callers must pass it explicitly.
  -->
  <Target Name="VerifyStandaloneSpineMirror" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(StandaloneSpineRoot)' == '' and '$(RequireSpineMirrorVerification)' == 'true'"
      Text="Shared-Spine mirror could not be verified: the build control plane did not supply a standalone Spine root. A shipping build must verify the mirror. Pass /p:StandaloneSpineRoot=&lt;path to Spine repo&gt; only as an explicit override." />
    <Warning
      Condition="'$(StandaloneSpineRoot)' == '' and '$(RequireSpineMirrorVerification)' != 'true'"
      Text="Shared-Spine mirror NOT verified: no standalone Spine checkout resolved, so embedded Spine sources may be stale. This build is not release-eligible." />
    <Exec
      Condition="'$(StandaloneSpineRoot)' != ''"
      Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Tools\Sync-StandaloneSpine.ps1&quot; -Mode $(SpineMirrorMode) -StandaloneRoot &quot;$(StandaloneSpineRoot)&quot;" />
  </Target>
  <Target Name="RequireStandaloneSpineReference" BeforeTargets="ResolveReferences" Condition="'$(UseStandaloneSpine)' == 'true'">
    <Error
      Condition="'$(SpineAssemblyPath)' == '' or !Exists('$(SpineAssemblyPath)')"
      Text="SpineMode=External requires SpineAssemblyPath to point to the standalone Spine.dll." />
  </Target>
  <Target Name="PreventBundledHarmonyOutput" AfterTargets="ResolveReferences" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == '0Harmony.dll'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveBundledHarmonySymbols" AfterTargets="Build">
    <Delete Files="$(OutDir)0Harmony.pdb" />
  </Target>
  <Target Name="RejectStandaloneSpinePayload" AfterTargets="Build">
    <ItemGroup>
      <ForbiddenSpinePayload Include="$(MSBuildProjectDirectory)\..\1.6\Assemblies\Spine*.dll" />
      <ForbiddenSpinePayload
        Include="$(MSBuildProjectDirectory)\..\1.6\ExternalSpine\Assemblies\Spine*.dll" />
    </ItemGroup>
    <Error
      Condition="'@(ForbiddenSpinePayload)' != ''"
      Text="BWT must embed its transpiler implementation and may not ship a separate Spine assembly. Remove forbidden Spine payload: @(ForbiddenSpinePayload)" />
  </Target>
